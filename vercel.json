{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/leaderboard",
      "destination": "/api/leaderboard"
    },
    {
      "source": "/api/leaderboard/:match*",
      "destination": "/api/leaderboard/:match*"
    },
    {
      "source": "/((?!api/.*).*)",
      "destination": "/index.html"
    }
  ]
}
