let blitzTimer: number | null = null

function loadLeaderboard(): BoardEntry[] {
  try {
    if (localStorage.getItem(legacyResetKey) !== '1') {
      localStorage.removeItem('how-well-do-you-know-me.leaderboard.v1')
      localStorage.removeItem('how-well-do-you-know-me.sequence.v1')
      localStorage.setItem(legacyResetKey, '1')
    }
    const parsed = JSON.parse(localStorage.getItem(leaderboardKey) ?? '[]') as BoardEntry[]
    return Array.isArray(parsed) ? sortEntries(parsed).slice(0, 10) : []
  } catch {
    return []
  }
}

function saveLeaderboard(): void {
  const entry: BoardEntry = {
    id: nextEntryId(),
    name: state.playerName || 'Anonymous',
    score: state.finalScore,
    mainScore: state.mainScore,
    blitzScore: state.blitzScore,
    timeBonus: state.timeBonus,
  }
  state.lastEntryId = entry.id
  state.entries = sortEntries([entry, ...state.entries]).slice(0, 10)
  try {
    localStorage.setItem(leaderboardKey, JSON.stringify(state.entries))
  } catch {
    // The game remains playable when storage is unavailable.
  }
}

function sortEntries(entries: BoardEntry[]): BoardEntry[] {
  return [...entries].sort((a, b) => b.score - a.score || b.timeBonus - a.timeBonus || a.id - b.id)
}

function nextEntryId(): number {
  let last = 0
  try { last = Number(localStorage.getItem(sequenceKey) ?? 0) || 0 } catch { /* no-op */ }
  const next = Math.max(Date.now(), last + 1)
  try { localStorage.setItem(sequenceKey, String(next)) } catch { /* no-op */ }
  return next
}

function esc(value: string): string {
  return value.replace(/[&<>"']/g, char => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' })[char] ?? char)
}

function render(): void {
  document.body.dataset.theme = state.screen === 'quiz' ? questions[state.questionIndex].theme : state.screen === 'blitz' || state.screen === 'blitz-intro' ? 'blitz' : 'intro'
  if (state.screen === 'intro') root.innerHTML = renderIntro()
  if (state.screen === 'quiz') root.innerHTML = renderQuiz()
  if (state.screen === 'blitz-intro') root.innerHTML = renderBlitzIntro()
  if (state.screen === 'blitz') root.innerHTML = renderBlitz()
  if (state.screen === 'results') root.innerHTML = renderResults()
  bindActions()
  if (state.screen === 'blitz') updateTimerDisplay()
}

