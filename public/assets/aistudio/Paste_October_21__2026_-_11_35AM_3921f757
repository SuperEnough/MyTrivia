function renderChoice(choice: Choice, index: number, correctId: string | null, selectedId: string | null): string {
  const isSelected = selectedId === choice.id
  const isCorrect = correctId === choice.id
  const status = correctId ? isCorrect ? 'is-correct' : isSelected ? 'is-wrong' : 'is-dimmed' : ''
  const visual = choice.src ? `<img src="${choice.src}" alt="${choice.alt ?? choice.label}" />` : `<span class="symbol-visual">${choice.symbol ?? '?'}</span>`
  return `<button class="choice-card ${status} ${isSelected ? 'is-selected' : ''}" data-main-answer="${choice.id}" ${correctId ? 'disabled' : ''} aria-pressed="${isSelected}"><span class="choice-number">0${index + 1}</span><span class="choice-visual">${visual}</span><span class="choice-label">${choice.label}</span>${correctId ? `<span class="choice-state">${isCorrect ? 'ANSWER' : isSelected ? 'YOUR PICK' : ''}</span>` : '<span class="choice-arrow">↗</span>'}</button>`
}

