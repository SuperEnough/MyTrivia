function renderLeaderboard(label: string): string {
  const rows = state.entries.length ? state.entries.slice(0, 7).map((entry, index) => `<li class="board-row ${entry.id === state.lastEntryId ? 'is-me' : ''}"><b>${String(index + 1).padStart(2, '0')}</b><span class="board-name">${esc(entry.name)}</span><span class="board-main">${entry.mainScore}</span><em>${entry.score}</em></li>`).join('') : '<li class="board-empty">No scores yet. Put your name on the signal.</li>'
  return `<div class="leaderboard"><div class="board-label"><span>${label}</span><span>MAIN / TOTAL</span></div><div class="board-head"><span>#</span><span>PLAYER</span><span>MAIN</span><em>TOTAL</em></div><ol>${rows}</ol></div>`
}

function getRank(): number {
  const index = state.entries.findIndex(entry => entry.id === state.lastEntryId)
  return index >= 0 ? index + 1 : state.entries.length + 1
}

function startGame(name: string): void {
  const cleaned = name.trim().replace(/\s+/g, ' ').slice(0, 18)
  if (!cleaned) {
    state.notice = 'Drop a name first. The leaderboard needs a legend.'
    render()
    return
  }
  if (state.entries.some(entry => entry.name.toLowerCase() === cleaned.toLowerCase())) {
    state.playerName = ''
    state.notice = `${cleaned} has already used their one chance. Try a different player name.`
    render()
    return
  }
  state.playerName = cleaned
  state.notice = ''
  state.questionIndex = 0
  state.selectedMain = null
  state.mainAnswered = false
  state.mainScore = 0
  state.mainCorrectCount = 0
  state.blitzSelections = [null, null]
  state.blitzRemaining = 30
  state.blitzScore = 0
  state.timeBonus = 0
  state.finalScore = 0
  state.lastEntryId = null
  state.screen = 'quiz'
  render()
}

function chooseMain(id: string): void {
  if (state.screen !== 'quiz' || state.mainAnswered) return
  state.selectedMain = id
  state.mainAnswered = true
  if (id === questions[state.questionIndex].correct) {
    state.mainScore += 100
    state.mainCorrectCount += 1
  }
  render()
}

function nextMain(): void {
  if (!state.mainAnswered) return
  if (state.questionIndex === questions.length - 1) {
    state.screen = 'blitz-intro'
  } else {
    state.questionIndex += 1
    state.selectedMain = null
    state.mainAnswered = false
  }
  render()
}

function startBlitz(): void {
  clearBlitzTimer()
  state.blitzSelections = [null, null]
  state.blitzRemaining = 30
  state.blitzDeadline = Date.now() + 30_000
  state.screen = 'blitz'
  render()
  blitzTimer = window.setInterval(() => {
    state.blitzRemaining = Math.max(0, Math.ceil((state.blitzDeadline - Date.now()) / 1000))
    updateTimerDisplay()
    if (state.blitzRemaining <= 0) finishBlitz()
  }, 100)
}

function chooseBlitz(questionIndex: number, answer: string): void {
  if (state.screen !== 'blitz' || state.blitzRemaining <= 0) return
  state.blitzSelections[questionIndex] = answer
  render()
}

function finishBlitz(): void {
  if (state.screen !== 'blitz') return
  clearBlitzTimer()
  state.blitzRemaining = Math.max(0, Math.ceil((state.blitzDeadline - Date.now()) / 1000))
  const dayPoints = state.blitzSelections[0] === '304' ? 150 : state.blitzSelections[0] === '305' ? 50 : 0
  const leftPoints = state.blitzSelections[1] === '61' ? 150 : 0
  state.timeBonus = state.blitzRemaining * 10
  state.blitzScore = dayPoints + leftPoints + state.timeBonus
  state.finalScore = state.mainScore + state.blitzScore
  state.screen = 'results'
  saveLeaderboard()
  render()
}

function clearBlitzTimer(): void {
  if (blitzTimer !== null) window.clearInterval(blitzTimer)
  blitzTimer = null
}

function updateTimerDisplay(): void {
  const timer = document.querySelector<HTMLElement>('#blitz-timer')
  if (!timer) return
  const value = timer.querySelector<HTMLElement>('.timer-number')
  if (value) value.textContent = String(state.blitzRemaining)
  timer.style.setProperty('--timer-progress', `${(state.blitzRemaining / 30) * 100}%`)
  timer.dataset.urgent = state.blitzRemaining <= 10 ? 'true' : 'false'
}

function replay(): void {
  clearBlitzTimer()
  state.screen = 'intro'
  state.playerName = ''
  state.questionIndex = 0
  state.selectedMain = null
  state.mainAnswered = false
  state.notice = ''
  render()
}

function bindActions(): void {
  root.querySelector<HTMLFormElement>('#start-form')?.addEventListener('submit', event => {
    event.preventDefault()
    const input = root.querySelector<HTMLInputElement>('#player-name')
    startGame(input?.value ?? '')
  })
  root.querySelectorAll<HTMLButtonElement>('[data-main-answer]').forEach(button => button.addEventListener('click', () => chooseMain(button.dataset.mainAnswer ?? '')))
  root.querySelector<HTMLButtonElement>('[data-action="next-main"]')?.addEventListener('click', nextMain)
  root.querySelector<HTMLButtonElement>('[data-action="start-blitz"]')?.addEventListener('click', startBlitz)
  root.querySelector<HTMLButtonElement>('[data-action="lock-blitz"]')?.addEventListener('click', finishBlitz)
  root.querySelectorAll<HTMLButtonElement>('[data-blitz-answer]').forEach(button => button.addEventListener('click', () => chooseBlitz(Number(button.dataset.blitzQuestion ?? 0), button.dataset.blitzAnswer ?? '')))
  root.querySelector<HTMLButtonElement>('[data-action="home"]')?.addEventListener('click', replay)
  const input = root.querySelector<HTMLInputElement>('#player-name')
  if (input && state.screen === 'intro') window.setTimeout(() => input.focus(), 50)
}

function setupAtmosphere(): void {
  const ctx = canvas.getContext('2d')
  if (!ctx) return
  const particles = Array.from({ length: 52 }, (_, index) => ({
    x: Math.random(), y: Math.random(), radius: 1 + Math.random() * 2.8, speed: 0.0001 + Math.random() * 0.00035, drift: (Math.random() - 0.5) * 0.0002, phase: index * 0.83,
  }))
  const resize = () => { const dpr = Math.min(window.devicePixelRatio || 1, 2); canvas.width = Math.floor(innerWidth * dpr); canvas.height = Math.floor(innerHeight * dpr); ctx.setTransform(dpr, 0, 0, dpr, 0, 0) }
  const draw = (time: number) => {
    ctx.clearRect(0, 0, innerWidth, innerHeight)
    const gradient = ctx.createRadialGradient(innerWidth * 0.72, innerHeight * 0.2, 0, innerWidth * 0.5, innerHeight * 0.5, innerWidth * 0.85)
    gradient.addColorStop(0, 'rgba(42, 36, 89, 0.72)')
    gradient.addColorStop(1, 'rgba(8, 9, 23, 0.98)')
    ctx.fillStyle = gradient
    ctx.fillRect(0, 0, innerWidth, innerHeight)
    for (const particle of particles) {
      const x = ((particle.x + Math.sin(time * particle.drift + particle.phase) * 0.04 + 1) % 1) * innerWidth
      const y = ((particle.y - time * particle.speed + particle.phase * 0.00002 + 2) % 1) * innerHeight
      ctx.beginPath(); ctx.arc(x, y, particle.radius, 0, Math.PI * 2); ctx.fillStyle = particle.phase % 2 > 1 ? 'rgba(104,247,237,.32)' : 'rgba(255,122,69,.26)'; ctx.fill()
    }
    window.requestAnimationFrame(draw)
  }
  window.addEventListener('resize', resize)
  resize()
  window.requestAnimationFrame(draw)
}

window.addEventListener('keydown', event => {
  if (state.screen === 'quiz') {
    const number = Number(event.key)
    if (!state.mainAnswered && number >= 1 && number <= questions[state.questionIndex].choices.length) chooseMain(questions[state.questionIndex].choices[number - 1].id)
    else if (state.mainAnswered && event.key === 'Enter') nextMain()
  } else if (state.screen === 'blitz') {
    if (event.key === 'Enter' && state.blitzSelections.every(Boolean)) finishBlitz()
  } else if (state.screen === 'results' && event.key === 'Enter') replay()
})

setupAtmosphere()
render()
